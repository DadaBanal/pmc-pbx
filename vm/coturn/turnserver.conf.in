# PMC PBX call relay - coturn 4.18.0 on PMC-PBX01 (WS47, 14 Oct 2026; Dada: "do the call relay now").
# Installed as /etc/coturn/turnserver.conf by vm/coturn/install-coturn.sh, which puts the shared secret in place of
# @SECRET@ (the same value as secrets.json "turn", from which app/lib/relay.js makes each phone's credentials).
# Every option below is in coturn 4.18.0's examples/etc/turnserver.conf.
#
# Reached by phones as relay.pmcne.ph = 103.144.157.236, forwarded by the UDM to 10.2.0.12 (TCP 443, TCP+UDP 3478).
# It relays to ONE place: the browser phone's engine address 10.2.0.11, UDP 10000-10999. The host firewall pins
# user turnserver to exactly that too, so a flaw in coturn's own peer rules (CVE-2026-27624 was one) still stops here.

listening-ip=10.2.0.12
relay-ip=10.2.0.12
# no external-ip on purpose: the relayed address phones announce must be 10.2.0.12, which the engine reaches on the LAN
listening-port=3478
tls-listening-port=443
no-dtls
min-port=49160
max-port=49999

realm=relay.pmcne.ph
server-name=relay.pmcne.ph
fingerprint
use-auth-secret
static-auth-secret=@SECRET@
stale-nonce=600

# the wildcard *.pmcne.ph certificate the phone site uses, handed over by systemd (LoadCredential in coturn.service)
cert=/run/credentials/coturn.service/cert.pem
pkey=/run/credentials/coturn.service/key.pem
no-tlsv1
no-tlsv1_1
cipher-list="ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305"

# where it may relay: nowhere, except the engine
denied-peer-ip=0.0.0.0-255.255.255.255
denied-peer-ip=::-ffff:ffff:ffff:ffff:ffff:ffff:ffff:ffff
allowed-peer-ip=10.2.0.11
no-multicast-peers
no-tcp-relay

# limits: a call is ~100 kbit/s each way; these leave room and stop abuse
user-quota=6
total-quota=200
max-bps=64000

no-cli
no-rfc5780
no-stun-backward-compatibility
response-origin-only-with-rfc5780
no-software-attribute
syslog
simple-log
pidfile=/run/coturn/turnserver.pid

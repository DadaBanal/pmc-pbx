# PMC PBX call relay (WS47). Installed as /etc/systemd/system/coturn.service by vm/coturn/install-coturn.sh.
[Unit]
Description=PMC PBX call relay (coturn 4.18.0) on 10.2.0.12
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=turnserver
Group=turnserver
ExecStart=/opt/coturn/bin/turnserver -c /etc/coturn/turnserver.conf --no-stdout-log
# the *.pmcne.ph certificate, read by systemd as root and handed to the service; the key never becomes coturn-readable on disk
LoadCredential=cert.pem:/etc/pmc-pbx/tls/cert.pem
LoadCredential=key.pem:/etc/pmc-pbx/tls/key.pem
RuntimeDirectory=coturn
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
LimitNOFILE=65536
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
